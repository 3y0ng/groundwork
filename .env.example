# Groundwork environment
# The app runs fully with an in-browser store and the keyless mock AI engine
# even if none of these are set. Fill them in to turn on real AI (and, optionally,
# Supabase persistence).

# ---------------------------------------------------------------------------
# Real AI (optional) — bring your own key.
# The app talks to a small local proxy (npm run proxy) so your key NEVER ships
# in the browser bundle. To turn it on:
#   1. Set OPENAI_API_KEY below.
#   2. npm run proxy      (in one terminal)
#   3. npm run dev        (in another)
# ---------------------------------------------------------------------------

# Client-side (VITE_*) — safe to expose. Switch "mock" -> "openai" to go live.
VITE_AI_PROVIDER=mock
VITE_AI_PROXY_URL=http://localhost:8787

# Server-side (proxy only) — NEVER prefixed with VITE_, never sent to the browser.
AI_PROVIDER=openai
# Cost-efficient default. Any chat-completions model id works; verify current
# pricing before a public deployment.
AI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# Only if AI_PROVIDER=anthropic instead:
# ANTHROPIC_API_KEY=
# PORT=8787

# ---------------------------------------------------------------------------
# Supabase (optional: hosted auth + database). Not required to run locally.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
