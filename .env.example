# Groundwork environment
# The app runs fully with an in-browser mock store and a mock AI engine
# even if none of these are set. Fill them in to connect real services.

# --- Supabase (optional: enables auth + persistent database) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- AI provider (optional: enables live AI instead of the mock engine) ---
# Supported values for VITE_AI_PROVIDER: "mock" (default), "anthropic"
VITE_AI_PROVIDER=mock
# Only used when VITE_AI_PROVIDER=anthropic. Prefer a server-side proxy in
# production; never ship a real key in a public client bundle.
VITE_AI_PROXY_URL=
